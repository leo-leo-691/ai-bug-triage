# Use a DEVELOPMENT Supabase project here. Production credentials belong only in
# Vercel (Project Settings -> Environment Variables, "Production" scope).

# Supabase Configuration
# Found in your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# AI Configuration (at least one of GEMINI_API_KEY / OPENAI_API_KEY is required;
# the server refuses to start without one)
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Optional: Set to 'v2' to use the updated severity prompt, otherwise defaults to the original
SEVERITY_PROMPT_VERSION=v2

# Optional model overrides (defaults shown)
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Research scripts in scripts/ refuse to run unless this is set. They write to
# (and run-evaluation.mjs deletes from) the project above. Never use production.
# ALLOW_SCRIPT_WRITES=true

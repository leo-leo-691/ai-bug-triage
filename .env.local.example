# Supabase Configuration
# Found in your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# AI Configuration (Provide either GEMINI_API_KEY or OPENAI_API_KEY)
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Optional: Set to 'v2' to use the updated severity prompt, otherwise defaults to the original
SEVERITY_PROMPT_VERSION=v2
